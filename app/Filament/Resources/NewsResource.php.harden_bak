<?php

namespace App\Filament\Resources;

use App\Filament\Resources\NewsResource\Pages;
use App\Models\Category;
use App\Models\News;
use Filament\Forms;
use Filament\Forms\Components\FileUpload;
use Filament\Forms\Components\MultiSelect;
use Filament\Forms\Components\Placeholder;
use Filament\Forms\Components\Select;
use Filament\Forms\Components\TextInput;
use Filament\Forms\Form;
use Filament\Resources\Resource;
use Filament\Tables;
use Filament\Tables\Table;
use Illuminate\Support\Facades\Storage;
use Illuminate\Support\HtmlString;
use Illuminate\Support\Str;

class NewsResource extends Resource
{
    protected static ?string $model = News::class;

    protected static ?string $navigationIcon = 'heroicon-o-newspaper';
    protected static ?string $navigationLabel = 'Haberler';
    protected static ?string $navigationGroup = 'İçerik';
    protected static ?int $navigationSort = 10;

    public static function form(Form $form): Form
    {
        return $form->schema([

            TextInput::make('title')
                ->label('Başlık')
                ->required()
                ->maxLength(255)
                ->live(onBlur: true)
                ->afterStateUpdated(function ($state, callable $set, callable $get) {
                    $currentSlug = (string) ($get('slug') ?? '');

                    if ($currentSlug === '' || $currentSlug === Str::slug((string) $get('title'))) {
                        $set('slug', Str::slug((string) $state));
                    }
                }),

            TextInput::make('slug')
                ->label('Slug')
                ->required()
                ->unique(ignoreRecord: true),

            Select::make('category_id')
                ->label('Kategori')
                ->relationship('category', 'name')
                ->searchable()
                ->preload()
                ->required()
                ->live()
                ->afterStateUpdated(function ($state, $old, callable $set, callable $get) {
                    if (! $state) {
                        return;
                    }

                    $currentSelectedTagIds = collect($get('tags') ?? [])
                        ->map(fn ($id) => (int) $id)
                        ->filter()
                        ->values();

                    $oldDefaultTagIds = Category::query()
                        ->with('tags:id')
                        ->find($old)
                        ?->tags
                        ->pluck('id')
                        ->map(fn ($id) => (int) $id)
                        ->values()
                        ?? collect();

                    $newDefaultTagIds = Category::query()
                        ->with('tags:id')
                        ->find($state)
                        ?->tags
                        ->pluck('id')
                        ->map(fn ($id) => (int) $id)
                        ->values()
                        ?? collect();

                    $manualTagIds = $currentSelectedTagIds
                        ->reject(fn ($id) => $oldDefaultTagIds->contains($id))
                        ->values();

                    $mergedTagIds = $manualTagIds
                        ->merge($newDefaultTagIds)
                        ->unique()
                        ->values()
                        ->all();

                    $set('tags', $mergedTagIds);
                }),

            MultiSelect::make('tags')
                ->label('Etiketler')
                ->relationship('tags', 'name')
                ->preload()
                ->searchable(),

            Forms\Components\RichEditor::make('content')
                ->label('İçerik')
                ->required()
                ->columnSpanFull(),

            Select::make('status')
                ->label('Durum')
                ->options([
                    News::STATUS_DRAFT => 'Taslak',
                    News::STATUS_IN_REVIEW => 'İncelemede',
                    News::STATUS_PUBLISHED => 'Yayında',
                ])
                ->default(News::STATUS_DRAFT)
                ->required()
                ->disabled(fn () => auth()->user()?->isEditor())
                ->dehydrated(),

            Forms\Components\DateTimePicker::make('published_at')
                ->label('Yayın Tarihi')
                ->default(now())
                ->disabled()
                ->dehydrated(false),

            Forms\Components\Toggle::make('is_ai_generated')
                ->label('AI Üretimi')
                ->default(false),

            Placeholder::make('current_cover_preview')
                ->label('Mevcut Kapak')
                ->visible(fn (?News $record): bool => filled($record))
                ->content(function (?News $record): HtmlString|string {
                    if (! $record) {
                        return 'Henüz kayıt oluşmadı.';
                    }

                    $media = $record->primaryCover()->first();

                    if ($media && $media->path) {
                        $url = Storage::disk($media->disk ?: 'public')->url($media->path);

                        return new HtmlString(
                            '<div style="display:flex;flex-direction:column;gap:8px;">'
                            . '<img src="' . e($url) . '" alt="Current cover" style="max-width:320px;border-radius:8px;border:1px solid #ddd;" />'
                            . '<div style="font-size:12px;opacity:.8;">Media Core: ' . e($media->original_name ?: basename($media->path)) . '</div>'
                            . '</div>'
                        );
                    }

                    if ($record->cover_image_path) {
                        $legacyUrl = Str::startsWith($record->cover_image_path, ['http://', 'https://'])
                            ? $record->cover_image_path
                            : asset('storage/' . ltrim($record->cover_image_path, '/'));

                        return new HtmlString(
                            '<div style="display:flex;flex-direction:column;gap:8px;">'
                            . '<img src="' . e($legacyUrl) . '" alt="Legacy cover" style="max-width:320px;border-radius:8px;border:1px solid #ddd;" />'
                            . '<div style="font-size:12px;opacity:.8;">Legacy: ' . e($record->cover_image_path) . '</div>'
                            . '</div>'
                        );
                    }

                    return 'Kapak görseli yok.';
                })
                ->columnSpanFull(),

            FileUpload::make('cover_upload')
                ->label('Kapak Görseli')
                ->image()
                ->imageEditor()
                ->storeFiles(false)
                ->nullable()
                ->helperText('Yeni yükleme Media Core üzerinden kaydedilir.')
                ->columnSpanFull(),

            Placeholder::make('current_video_preview')
                ->label('Mevcut Video')
                ->visible(fn (?News $record): bool => filled($record))
                ->content(function (?News $record): HtmlString|string {
                    if (! $record) {
                        return 'Henüz kayıt oluşmadı.';
                    }

                    $video = $record->videoMedia()
                        ->orderBy('mediaables.sort_order')
                        ->first();

                    if (! $video) {
                        return 'Video yok.';
                    }

                    $provider = $video->embed_provider ?: 'video';
                    $url = $video->embed_url ?: '#';
                    $label = $video->title_override ?: $video->original_name ?: $url;

                    return new HtmlString(
                        '<div style="display:flex;flex-direction:column;gap:10px;padding:12px;border:1px solid #2f2f2f;border-radius:8px;background:#111827;">'
                        . '<div style="font-size:12px;opacity:.85;"><strong>Provider:</strong> ' . e($provider) . '</div>'
                        . '<div style="font-size:12px;word-break:break-all;"><a href="' . e($url) . '" target="_blank" rel="noopener noreferrer" style="color:#93c5fd;text-decoration:underline;">' . e($label) . '</a></div>'
                        . '<div style="display:flex;gap:8px;flex-wrap:wrap;">'
                        . '<button type="button" wire:click="removeVideo(' . $video->id . ')" style="padding:6px 10px;border:none;border-radius:6px;background:#374151;color:#fff;font-size:12px;cursor:pointer;">Çıkart</button>'
                        . '<button type="button" wire:click="deleteVideo(' . $video->id . ')" style="padding:6px 10px;border:none;border-radius:6px;background:#b91c1c;color:#fff;font-size:12px;cursor:pointer;">Sil</button>'
                        . '</div>'
                        . '</div>'
                    );
                })
                ->columnSpanFull(),

            TextInput::make('video_url')
                ->label('Video URL')
                ->nullable()
                ->placeholder('https://www.youtube.com/watch?v=...')
                ->helperText('Yeni video eklersen mevcut video değiştirilir. Boş bırakırsan mevcut video korunur.')
                ->columnSpanFull(),

            Placeholder::make('current_gallery_preview')
                ->label('Mevcut Galeri')
                ->visible(fn (?News $record): bool => filled($record))
                ->content(function (?News $record): HtmlString|string {
                    if (! $record) {
                        return 'Henüz kayıt oluşmadı.';
                    }

                    $galleryItems = $record->galleryMedia()
                        ->orderBy('mediaables.sort_order')
                        ->get();

                    if ($galleryItems->isEmpty()) {
                        return 'Galeri görseli yok.';
                    }

                    $html = '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px;">';

                    foreach ($galleryItems as $media) {
                        if (! $media->path) {
                            continue;
                        }

                        $url = Storage::disk($media->disk ?: 'public')->url($media->path);
                        $name = $media->original_name ?: basename($media->path);

                        $html .= '<div style="display:flex;flex-direction:column;gap:8px;padding:8px;border:1px solid #2f2f2f;border-radius:8px;background:#111827;">';
                        $html .= '<img src="' . e($url) . '" alt="' . e($name) . '" style="width:100%;height:140px;object-fit:cover;border-radius:6px;border:1px solid #333;" />';
                        $html .= '<div style="font-size:11px;opacity:.85;word-break:break-word;">' . e($name) . '</div>';
                        $html .= '<div style="display:flex;gap:8px;flex-wrap:wrap;">';
                        $html .= '<button type="button" wire:click="removeFromGallery(' . $media->id . ')" style="padding:6px 10px;border:none;border-radius:6px;background:#374151;color:#fff;font-size:12px;cursor:pointer;">Çıkart</button>';
                        $html .= '<button type="button" wire:click="deleteMedia(' . $media->id . ')" style="padding:6px 10px;border:none;border-radius:6px;background:#b91c1c;color:#fff;font-size:12px;cursor:pointer;">Sil</button>';
                        $html .= '</div>';
                        $html .= '</div>';
                    }

                    $html .= '</div>';

                    return new HtmlString($html);
                })
                ->columnSpanFull(),

            FileUpload::make('gallery_upload')
                ->label('Galeri Görselleri')
                ->multiple()
                ->image()
                ->imageEditor()
                ->storeFiles(false)
                ->nullable()
                ->helperText('Birden fazla görsel yüklenebilir. Media Core üzerinden galeri olarak kaydedilir.')
                ->columnSpanFull(),

        ]);
    }

    public static function table(Table $table): Table
    {
        return $table
            ->columns([

                Tables\Columns\TextColumn::make('title')
                    ->label('Başlık')
                    ->searchable(),

                Tables\Columns\TextColumn::make('category.name')
                    ->label('Kategori'),

                Tables\Columns\TagsColumn::make('tags.name')
                    ->label('Etiketler'),

                Tables\Columns\TextColumn::make('status')
                    ->label('Durum')
                    ->badge()
                    ->color(fn (string $state): string => match ($state) {
                        News::STATUS_DRAFT => 'gray',
                        News::STATUS_IN_REVIEW => 'warning',
                        News::STATUS_PUBLISHED => 'success',
                        default => 'gray',
                    })
                    ->formatStateUsing(fn (string $state): string => match ($state) {
                        News::STATUS_DRAFT => 'Taslak',
                        News::STATUS_IN_REVIEW => 'İncelemede',
                        News::STATUS_PUBLISHED => 'Yayında',
                        default => $state,
                    }),

                Tables\Columns\TextColumn::make('published_at')
                    ->label('Yayın')
                    ->dateTime()
                    ->sortable(),

                Tables\Columns\TextColumn::make('author.name')
                    ->label('Yazar')
                    ->sortable(),
            ])
            ->filters([
                Tables\Filters\SelectFilter::make('status')
                    ->label('Durum')
                    ->options([
                        News::STATUS_DRAFT => 'Taslak',
                        News::STATUS_IN_REVIEW => 'İncelemede',
                        News::STATUS_PUBLISHED => 'Yayında',
                    ]),
            ])
            ->actions([
                Tables\Actions\ActionGroup::make([
                    Tables\Actions\EditAction::make(),
                    
                    // ONNAYA GÖNDER (Sadece Editor ve sadece Draft ise)
                    Tables\Actions\Action::make('send_to_review')
                        ->label('Onaya Gönder')
                        ->icon('heroicon-o-paper-airplane')
                        ->color('warning')
                        ->visible(fn (News $record) => $record->isDraft() && auth()->user()?->isEditor())
                        ->authorize(fn (News $record) => auth()->user()?->can('update', $record))
                        ->action(fn (News $record) => $record->update(['status' => News::STATUS_IN_REVIEW])),

                    // YAYINLA (Sadece Admin/SuperAdmin)
                    Tables\Actions\Action::make('publish')
                        ->label('Yayınla')
                        ->icon('heroicon-o-check-circle')
                        ->color('success')
                        ->visible(fn (News $record) => !$record->isPublished() && (auth()->user()?->isAdmin() || auth()->user()?->isSuperAdmin()))
                        ->authorize(fn (News $record) => auth()->user()?->isAdmin() || auth()->user()?->isSuperAdmin())
                        ->action(fn (News $record) => $record->update(['status' => News::STATUS_PUBLISHED])),

                    // TASLAĞA ÇEK (Admin/SuperAdmin her zaman)
                    Tables\Actions\Action::make('revoke')
                        ->label('Taslağa Geri Çek')
                        ->icon('heroicon-o-arrow-uturn-left')
                        ->color('danger')
                        ->visible(fn (News $record) => !$record->isDraft() && (auth()->user()?->isAdmin() || auth()->user()?->isSuperAdmin()))
                        ->authorize(fn (News $record) => auth()->user()?->isAdmin() || auth()->user()?->isSuperAdmin())
                        ->action(fn (News $record) => $record->update(['status' => News::STATUS_DRAFT])),

                    Tables\Actions\DeleteAction::make(),
                ]),
            ])
            ->bulkActions([
                Tables\Actions\BulkActionGroup::make([
                    Tables\Actions\DeleteBulkAction::make(),
                ]),
            ]);
    }

    public static function getPages(): array
    {
        return [
            'index' => Pages\ListNews::route('/'),
            'create' => Pages\CreateNews::route('/create'),
            'edit' => Pages\EditNews::route('/{record}/edit'),
        ];
    }
}